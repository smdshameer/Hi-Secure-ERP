# ==============================================================================
# HISECURE ERP V2.0 - PRODUCTION ENVIRONMENT TEMPLATE (production.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' inside the server directory.
# 2. Update all values with production secrets and connection parameters.
# 3. Ensure this file is never committed to version control.
# ==============================================================================

# ─── CORE SERVER SETTINGS ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3004
CLIENT_URL="https://erp.yourdomain.com"

# ─── SECURITY & AUTHENTICATION ────────────────────────────────────────────────
# Generate a cryptographically secure 64-character key using: openssl rand -hex 64
JWT_SECRET="YOUR_RANDOM_SECURE_JWT_SECRET_HEX"

# ─── POSTGRESQL DATABASE CONNECTION ───────────────────────────────────────────
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public&sslmode=require
# Always use a dedicated application user and enforce SSL in production
DATABASE_URL="postgresql://hisecure_app:STRONG_DATABASE_PASSWORD@postgres-host:5432/hisecure_erp?schema=public&sslmode=require"

# ─── REDIS CACHE & BACKGROUND QUEUES ──────────────────────────────────────────
# Format: redis://:[password]@[host]:[port]/[db_index]
# Enforce auth passwords and persistent storage for BullMQ
REDIS_URL="redis://:STRONG_REDIS_PASSWORD@redis-host:6379/0"

# ─── EMAIL (SMTP) NOTIFICATIONS ───────────────────────────────────────────────
# Fallback email configuration if database settings are not initialized
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_SECURE=false

# ─── WHATSAPP INTEGRATION (META API) ──────────────────────────────────────────
# WhatsApp is primarily configured in the database settings table.
# Use these environment variables as production setup overrides/seed values:
WHATSAPP_PHONE_NUMBER_ID="YOUR_META_PHONE_NUMBER_ID"
WHATSAPP_ACCESS_TOKEN="YOUR_META_PERMANENT_ACCESS_TOKEN"
WHATSAPP_BUSINESS_ACCOUNT_ID="YOUR_META_BUSINESS_ACCOUNT_ID"
WHATSAPP_ENABLED=true

# ─── TELEGRAM BOT WORKER ──────────────────────────────────────────────────────
# The Telegram worker monitors state changes and alerts admins.
TELEGRAM_BOT_ENABLED=true
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_HTTP_API_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_ADMIN_CHAT_ID"

# ─── FILE UPLOADS & ANTIVIRUS HARDENING ────────────────────────────────────────
# Restricts attachment scanning. Enforce ClamAV in production.
ANTIVIRUS_PROVIDER=clamav
CLAMAV_HOST="clamav-host"
CLAMAV_PORT=3310
