model OfflineSyncQueue {
  sync_id       Int      @id @default(autoincrement())
  user_id       Int      @map("user_id")
  device_id     String   @db.VarChar(100) @map("device_id")
  entity_type   String   @db.VarChar(50) @map("entity_type")
  operation     String   @db.VarChar(10) @map("operation")
  payload       Json     @map("payload")
  status        String   @default("PENDING") @db.VarChar(20)
  error_message String?  @db.Text @map("error_message")
  retry_count   Int      @default(0) @map("retry_count")
  created_at    DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("offline_sync_queues")
}

model MobileDeviceSession {
  session_id   Int       @id @default(autoincrement())
  user_id      Int       @map("user_id")
  device_id    String    @db.VarChar(100) @map("device_id")
  push_token   String?   @db.VarChar(512) @map("push_token")
  last_sync_at DateTime? @map("last_sync_at")
  created_at   DateTime  @default(now()) @map("created_at")

  user         User      @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("mobile_device_sessions")
}

model WhatsAppLog {
  log_id          Int      @id @default(autoincrement())
  recipient_phone String   @db.VarChar(50) @map("recipient_phone")
  message_type    String   @db.VarChar(50) @map("message_type")
  payload         Json     @map("payload")
  status          String   @default("SENT") @db.VarChar(20)
  error_message   String?  @db.Text @map("error_message")
  created_at      DateTime @default(now()) @map("created_at")

  @@map("whatsapp_logs")
}

model TokenBlacklist {
  blacklist_id  Int      @id @default(autoincrement())
  token_jti     String   @unique @db.VarChar(255) @map("token_jti")
  user_id       Int      @map("user_id")
  expires_at    DateTime @map("expires_at")
  created_at    DateTime @default(now()) @map("created_at")

  user          User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@map("token_blacklist")
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
}

model Tenant {
  id              String           @id @default(uuid())
  name            String           @db.VarChar(255)
  subdomain       String           @unique @db.VarChar(100)
  status          TenantStatus     @default(TRIAL)
  plan            SubscriptionPlan @default(BASIC)
  licenseKey      String           @unique @db.VarChar(255) @map("license_key")
  expiresAt       DateTime         @map("expires_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  users           User[]
  devices         ActiveDevice[]

  @@map("saas_tenants")
}

model ActiveDevice {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  userId          Int              @map("user_id")
  ipAddress       String           @db.VarChar(45) @map("ip_address")
  userAgent       String           @db.VarChar(512) @map("user_agent")
  deviceType      String           @db.VarChar(50) @map("device_type")
  os              String           @db.VarChar(50)
  browser         String           @db.VarChar(50)
  lastActiveAt    DateTime         @default(now()) @map("last_active_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@map("saas_active_devices")
}

