  session                     CatalogImportSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@map("supplier_price_changes")
}

model ImportApprovalHistory {
  id                            Int                  @id @default(autoincrement())
  session_id                    Int                  @map("session_id")
  action                        String               @db.VarChar(100)
  performed_by                  Int                  @map("performed_by")
  comments                      String?              @db.Text
  approved_price_changes_count  Int                  @default(0) @map("approved_price_changes_count")
  high_risk_price_changes_count Int                  @default(0) @map("high_risk_price_changes_count")
  approval_timestamp            DateTime             @default(now()) @map("approval_timestamp")
  created_at                    DateTime             @default(now()) @map("created_at")

  session                       CatalogImportSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@map("import_approval_histories")
}

model SupplierGovernance {
  supplier_id             Int       @id @map("supplier_id")
  trust_level             String    @default("STANDARD") @map("trust_level") @db.VarChar(50)
  governance_score        Int       @default(80) @map("governance_score")
  total_catalogs          Int       @default(0) @map("total_catalogs")
  successful_imports      Int       @default(0) @map("successful_imports")
  failed_imports          Int       @default(0) @map("failed_imports")
  rollback_count          Int       @default(0) @map("rollback_count")
  rejected_items_count    Int       @default(0) @map("rejected_items_count")
  duplicate_items_count   Int       @default(0) @map("duplicate_items_count")
  high_risk_changes_count Int       @default(0) @map("high_risk_changes_count")
  last_reviewed_at        DateTime? @map("last_reviewed_at")
  // Phase 2C — Supplier Performance Metrics
  delivery_delays_count   Int       @default(0) @map("delivery_delays_count")
  price_stability_score   Decimal   @default(100) @map("price_stability_score") @db.Decimal(5, 2)
  order_accuracy_score    Decimal   @default(100) @map("order_accuracy_score") @db.Decimal(5, 2)
  defect_rate             Decimal   @default(0) @map("defect_rate") @db.Decimal(5, 2)
  created_at              DateTime  @default(now()) @map("created_at")
