model FiscalPeriod {
  period_id  Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  start_date DateTime @map("start_date")
  end_date   DateTime @map("end_date")
  is_locked  Boolean  @default(false) @map("is_locked")
  created_at DateTime @default(now()) @map("created_at")

  @@map("fiscal_periods")
}

model GstTransaction {
  gst_transaction_id Int      @id @default(autoincrement())
  line_id            Int      @unique @map("line_id")
  hsn_sac_code       String?  @db.VarChar(20) @map("hsn_sac_code")
  taxable_value      Decimal  @db.Decimal(12, 2) @map("taxable_value")
  cgst_rate          Decimal  @db.Decimal(5, 2) @map("cgst_rate")
  cgst_amount        Decimal  @db.Decimal(12, 2) @map("cgst_amount")
  sgst_rate          Decimal  @db.Decimal(5, 2) @map("sgst_rate")
  sgst_amount        Decimal  @db.Decimal(12, 2) @map("sgst_amount")
  igst_rate          Decimal  @db.Decimal(5, 2) @map("igst_rate")
  igst_amount        Decimal  @db.Decimal(12, 2) @map("igst_amount")
  gstin              String?  @db.VarChar(15) @map("gstin")
  transaction_type   String   @db.VarChar(20) @map("transaction_type") // INPUT, OUTPUT

  line               JournalEntryLine @relation(fields: [line_id], references: [line_id], onDelete: Cascade)

  @@map("gst_transactions")
}

