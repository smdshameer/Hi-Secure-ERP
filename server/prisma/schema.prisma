  new_cost_price              Decimal              @map("new_cost_price") @db.Decimal(10, 2)
  old_selling_price           Decimal              @map("old_selling_price") @db.Decimal(10, 2)
  new_selling_price           Decimal              @map("new_selling_price") @db.Decimal(10, 2)
