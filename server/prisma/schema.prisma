// ============================================================
// Phase 2C — Procurement Operations
// ============================================================

model PurchaseRequisition {
  pr_id             Int                       @id @default(autoincrement())
  pr_number         String                    @unique @map("pr_number") @db.VarChar(50)
  request_date      DateTime                  @default(now()) @map("request_date")
  required_by_date  DateTime?                 @map("required_by_date")
  requested_by      Int                       @map("requested_by")
  supplier_id       Int?                      @map("supplier_id")
  priority          String                    @default("NORMAL") @map("priority") @db.VarChar(20)
  status            String                    @default("DRAFT") @map("status") @db.VarChar(30)
  remarks           String?
  approved_by       Int?                      @map("approved_by")
  approved_at       DateTime?                 @map("approved_at")
  rejected_reason   String?                   @map("rejected_reason")
  created_at        DateTime                  @default(now()) @map("created_at")
  updated_at        DateTime                  @updatedAt @map("updated_at")

  requestedBy       User                      @relation("RequisitionRequestedBy", fields: [requested_by], references: [user_id])
  supplier          Supplier?                 @relation(fields: [supplier_id], references: [supplier_id])
  items             PurchaseRequisitionItem[]
  purchaseOrders    PurchaseOrder[]

  @@index([status])
  @@index([requested_by])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  pr_item_id       Int                  @id @default(autoincrement())
  pr_id            Int                  @map("pr_id")
  part_id          Int                  @map("part_id")
  quantity         Int
  estimated_price  Decimal?             @map("estimated_price") @db.Decimal(10, 2)
  remarks          String?

  requisition      PurchaseRequisition  @relation(fields: [pr_id], references: [pr_id], onDelete: Cascade)
  part             Parts                @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@map("purchase_requisition_items")
}

model GoodsReceiptNote {
  grn_id            Int                    @id @default(autoincrement())
  grn_number        String                 @unique @map("grn_number") @db.VarChar(50)
  po_id             Int                    @map("po_id")
  location_id       Int?                   @map("location_id")
  received_date     DateTime               @default(now()) @map("received_date")
  received_by       Int                    @map("received_by")
  status            String                 @default("DRAFT") @map("status") @db.VarChar(30)
  supplier_invoice  String?                @map("supplier_invoice") @db.VarChar(100)
  remarks           String?
  posted_at         DateTime?              @map("posted_at")
  created_at        DateTime               @default(now()) @map("created_at")
  updated_at        DateTime               @updatedAt @map("updated_at")

  purchaseOrder     PurchaseOrder          @relation(fields: [po_id], references: [po_id])
  location          Location?              @relation(fields: [location_id], references: [location_id])
  receivedBy        User                   @relation("GrnReceivedBy", fields: [received_by], references: [user_id])
  items             GoodsReceiptNoteItem[]

  @@index([po_id])
  @@index([status])
  @@map("goods_receipt_notes")
}

model GoodsReceiptNoteItem {
  grn_item_id        Int              @id @default(autoincrement())
  grn_id             Int              @map("grn_id")
  po_item_id         Int?             @map("po_item_id")
  part_id            Int              @map("part_id")
  ordered_quantity   Int              @map("ordered_quantity")
  received_quantity  Int              @map("received_quantity")
  damaged_quantity   Int              @default(0) @map("damaged_quantity")
  shortage_quantity  Int              @default(0) @map("shortage_quantity")
  excess_quantity    Int              @default(0) @map("excess_quantity")
  unit_price         Decimal          @map("unit_price") @db.Decimal(10, 2)
  batch_number       String?          @map("batch_number")
  expiration_date    DateTime?        @map("expiration_date")
  remarks            String?

  grn                GoodsReceiptNote    @relation(fields: [grn_id], references: [grn_id], onDelete: Cascade)
  poItem             PurchaseOrderItems? @relation(fields: [po_item_id], references: [po_item_id])
  part               Parts               @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@map("goods_receipt_note_items")
}

model PartCostHistory {
  id               Int      @id @default(autoincrement())
  part_id          Int      @map("part_id")
  grn_id           Int?     @map("grn_id")
  old_cost_price   Decimal  @map("old_cost_price") @db.Decimal(10, 2)
  new_cost_price   Decimal  @map("new_cost_price") @db.Decimal(10, 2)
  adjustment_type  String   @default("GRN_RECEIPT") @map("adjustment_type") @db.VarChar(50)
  quantity_impact  Int      @map("quantity_impact")
  recorded_by      Int?     @map("recorded_by")
  recorded_at      DateTime @default(now()) @map("recorded_at")
  notes            String?

  part             Parts    @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@index([part_id])
  @@map("part_cost_histories")
}

model InventoryAdjustmentSnapshot {
  id                Int      @id @default(autoincrement())
  part_id           Int      @map("part_id")
  grn_id            Int?     @map("grn_id")
  snapshot_type     String   @default("PRE_GRN") @map("snapshot_type") @db.VarChar(50)
  stock_quantity    Int      @map("stock_quantity")
  cost_price        Decimal  @map("cost_price") @db.Decimal(10, 2)
  taken_at          DateTime @default(now()) @map("taken_at")
  notes             String?

  part              Parts    @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@index([part_id])
  @@map("inventory_adjustment_snapshots")
}

model WarehouseLocation {
  warehouse_location_id Int       @id @default(autoincrement())
  location_id           Int       @map("location_id")
  zone                  String?   @db.VarChar(50)
  rack                  String?   @db.VarChar(50)
  shelf                 String?   @db.VarChar(50)
  bin                   String?   @db.VarChar(50)
  name                  String    @db.VarChar(100)
  is_active             Boolean   @default(true) @map("is_active")
  created_at            DateTime  @default(now()) @map("created_at")
  updated_at            DateTime  @updatedAt @map("updated_at")

  location              Location  @relation(fields: [location_id], references: [location_id], onDelete: Cascade)
  binStocks             BinStock[]

  @@unique([location_id, name])
  @@map("warehouse_locations")
}

model BinStock {
  bin_stock_id          Int               @id @default(autoincrement())
  warehouse_location_id Int               @map("warehouse_location_id")
  part_id               Int               @map("part_id")
  quantity              Int               @default(0)
  created_at            DateTime          @default(now()) @map("created_at")
  updated_at            DateTime          @updatedAt @map("updated_at")

  warehouseLocation     WarehouseLocation @relation(fields: [warehouse_location_id], references: [warehouse_location_id], onDelete: Cascade)
  part                  Parts             @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@unique([warehouse_location_id, part_id])
  @@map("bin_stocks")
}

model StockReservation {
  reservation_id Int      @id @default(autoincrement())
  part_id        Int      @map("part_id")
  location_id    Int      @map("location_id")
  quantity       Int
  reference_type String   @db.VarChar(50)  // SalesOrder, Repair, etc.
  reference_id   Int
  status         String   @default("ACTIVE") @db.VarChar(30)  // ACTIVE/RELEASED/FULFILLED
  expires_at     DateTime?
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  location       Location @relation(fields: [location_id], references: [location_id], onDelete: Cascade)
  part           Parts    @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@map("stock_reservations")
}

model StockTransfer {
  transfer_id      Int                 @id @default(autoincrement())
  transfer_number  String              @unique @db.VarChar(50)
  from_location_id Int                 @map("from_location_id")
  to_location_id   Int                 @map("to_location_id")
  status           String              @default("DRAFT") @db.VarChar(30) // DRAFT/APPROVED/IN_TRANSIT/COMPLETING/COMPLETED/CANCELLED
  requested_by     Int?                @map("requested_by")
  approved_by      Int?                @map("approved_by")
  notes            String?             @db.Text
  created_at       DateTime            @default(now()) @map("created_at")
  updated_at       DateTime            @updatedAt @map("updated_at")

  fromLocation     Location            @relation("TransferFrom", fields: [from_location_id], references: [location_id])
  toLocation       Location            @relation("TransferTo", fields: [to_location_id], references: [location_id])
  items            StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  item_id     Int           @id @default(autoincrement())
  transfer_id Int           @map("transfer_id")
  part_id     Int           @map("part_id")
  quantity    Int

  transfer    StockTransfer @relation(fields: [transfer_id], references: [transfer_id], onDelete: Cascade)
  part        Parts         @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@map("stock_transfer_items")
}

model CycleCount {
  count_id       Int              @id @default(autoincrement())
  count_number   String           @unique @db.VarChar(50)
  location_id    Int              @map("location_id")
  status         String           @default("PLANNED") @db.VarChar(30) // PLANNED/IN_PROGRESS/PENDING_APPROVAL/COMPLETED
  planned_date   DateTime         @map("planned_date")
  completed_date DateTime?        @map("completed_date")
  counted_by     Int?             @map("counted_by")
  notes          String?          @db.Text
  created_at     DateTime         @default(now()) @map("created_at")
  updated_at     DateTime         @updatedAt @map("updated_at")

  location       Location         @relation(fields: [location_id], references: [location_id])
  items          CycleCountItem[]

  @@map("cycle_counts")
}

model CycleCountItem {
  item_id      Int        @id @default(autoincrement())
  count_id     Int        @map("count_id")
  part_id      Int        @map("part_id")
  expected_qty Int        @map("expected_qty")
  counted_qty  Int?       @map("counted_qty")
  variance     Int?       @map("variance")
  status       String     @default("PENDING") @db.VarChar(20) // PENDING/COUNTED

  cycleCount   CycleCount @relation(fields: [count_id], references: [count_id], onDelete: Cascade)
  part         Parts      @relation(fields: [part_id], references: [part_id], onDelete: Cascade)

  @@map("cycle_count_items")
}

model ServiceJob {
  job_id            Int                      @id @default(autoincrement())
  job_number        String                   @unique @db.VarChar(50)
  customer_id       Int                      @map("customer_id")
  job_type          String                   @db.VarChar(30) // FIELD_SERVICE, WORKSHOP, AMC
  status            String                   @default("OPEN") @db.VarChar(30) // OPEN, DIAGNOSING, ESTIMATED, ASSIGNED, IN_PROGRESS, PENDING_APPROVAL, RESOLVED, CLOSED
  priority          String                   @default("NORMAL") @db.VarChar(20)
  problem_description String                 @db.Text
  estimated_cost    Decimal?                 @db.Decimal(10, 2)
  actual_cost       Decimal                  @default(0) @db.Decimal(10, 2)
  warranty_status   Boolean                  @default(false)
  warranty_expiry   DateTime?
  notes             String?                  @db.Text
  created_at        DateTime                 @default(now()) @map("created_at")
  updated_at        DateTime                 @updatedAt @map("updated_at")

  customer          Customer                 @relation(fields: [customer_id], references: [customer_id])
  items             ServiceJobItem[]
  assignments       TechnicianAssignment[]
  visits            ServiceVisit[]
  resolutions       ServiceResolution[]
  claims            WarrantyClaim[]
  partsConsumed     ServicePartsConsumption[]

  // New relations for Phase 3C
  partsRequests     PartsRequest[]
  amcVisitSchedules AmcVisitSchedule[]

  @@map("service_jobs")
}

model ServiceJobItem {
  item_id           Int          @id @default(autoincrement())
  job_id            Int          @map("job_id")
  device_name       String       @db.VarChar(255)
  serial_number     String?      @db.VarChar(255)
  model_number      String?      @db.VarChar(255)
  issue_description String       @db.Text
  diagnosis         String?      @db.Text

  job               ServiceJob   @relation(fields: [job_id], references: [job_id], onDelete: Cascade)

  @@map("service_job_items")
}

model TechnicianAssignment {
  assignment_id     Int          @id @default(autoincrement())
  job_id            Int          @map("job_id")
  technician_id     Int          @map("technician_id")
  assigned_at       DateTime     @default(now())
  scheduled_date    DateTime
  status            String       @default("PENDING") @db.VarChar(30) // PENDING, ACCEPTED, COMPLETED, REASSIGNED

  job               ServiceJob   @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  technician        Technician   @relation(fields: [technician_id], references: [technician_id])

  @@map("technician_assignments")
}

model ServiceVisit {
  visit_id          Int          @id @default(autoincrement())
  job_id            Int          @map("job_id")
  technician_id     Int          @map("technician_id")
  visit_date        DateTime
  status            String       @default("PLANNED") @db.VarChar(30) // PLANNED, EXECUTED, CANCELLED
  findings          String?      @db.Text
  signature_url     String?      @db.VarChar(512)
  created_at        DateTime     @default(now())

  job               ServiceJob   @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  technician        Technician   @relation(fields: [technician_id], references: [technician_id])

  // New relations for Phase 3C
  activityLogs      TechnicianActivityLog[]
  attachments       VisitAttachment[]

  @@map("service_visits")
}

model ServiceResolution {
  resolution_id     Int          @id @default(autoincrement())
  job_id            Int          @map("job_id")
  resolved_by       Int          @map("resolved_by")
  resolved_at       DateTime     @default(now())
  first_visit_resolved Boolean   @default(true)
  resolution_notes  String       @db.Text
  customer_rating   Int?         // 1-5 rating

  job               ServiceJob   @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  technician        Technician   @relation(fields: [resolved_by], references: [technician_id])

  @@map("service_resolutions")
}

model WarrantyClaim {
  claim_id          Int          @id @default(autoincrement())
  job_id            Int          @map("job_id")
  part_id           Int          @map("part_id")
  claim_number      String       @unique @db.VarChar(50)
  claim_date        DateTime     @default(now())
  status            String       @default("PENDING") @db.VarChar(30) // PENDING, APPROVED, REJECTED
  approved_qty      Int          @default(0)
  reason            String?      @db.Text

  job               ServiceJob   @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  part              Parts        @relation(fields: [part_id], references: [part_id])

  @@map("warranty_claims")
}

model ServicePartsConsumption {
  consumption_id    Int          @id @default(autoincrement())
  job_id            Int          @map("job_id")
  part_id           Int          @map("part_id")
  location_id       Int          @map("location_id") // Warehouse/Location
  quantity          Int
  cost_price        Decimal      @db.Decimal(10, 2)
  selling_price     Decimal      @db.Decimal(10, 2)
  consumed_at       DateTime     @default(now())

  job               ServiceJob   @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  part              Parts        @relation(fields: [part_id], references: [part_id])
  location          Location     @relation(fields: [location_id], references: [location_id])

  @@map("service_parts_consumption")
}

// ─── PHASE 3C NEW MODELS ─────────────────────────────────────────────────────

model Lead {
  lead_id        Int            @id @default(autoincrement())
  lead_number    String         @unique @db.VarChar(50)
  first_name     String         @db.VarChar(100)
  last_name      String?        @db.VarChar(100)
  company_name   String?        @db.VarChar(255)
  email          String         @db.VarChar(255)
  phone          String         @db.VarChar(50)
  status         String         @default("NEW") @db.VarChar(20) // NEW, CONTACTED, QUALIFIED, LOST, CONVERTED
  assigned_to    Int?           @map("assigned_to")
  source         String?        @db.VarChar(100)
  notes          String?        @db.Text
  created_at     DateTime       @default(now()) @map("created_at")
  updated_at     DateTime       @updatedAt @map("updated_at")

  assignedUser   User?          @relation("LeadAssignee", fields: [assigned_to], references: [user_id])
  activities     LeadActivity[]
  opportunities  Opportunity[]
  followUps      FollowUp[]

  @@map("leads")
}

model LeadActivity {
  activity_id   Int      @id @default(autoincrement())
  lead_id       Int      @map("lead_id")
  activity_type String   @db.VarChar(50) @map("activity_type") // CALL, EMAIL, MEETING, NOTE
  notes         String   @db.Text
  created_by    Int      @map("created_by")
  created_at    DateTime @default(now()) @map("created_at")

  lead          Lead     @relation(fields: [lead_id], references: [lead_id], onDelete: Cascade)

  @@map("lead_activities")
}

model Opportunity {
  opportunity_id     Int        @id @default(autoincrement())
  opportunity_number String     @unique @db.VarChar(50) @map("opportunity_number")
  lead_id            Int?       @map("lead_id")
  customer_id        Int?       @map("customer_id")
  name               String     @db.VarChar(255)
  stage              String     @default("PROSPECTING") @db.VarChar(50) // PROSPECTING, QUALIFICATION, PROPOSAL, WON, LOST
  probability        Int        @default(10)
  estimated_revenue  Decimal    @db.Decimal(12, 2) @map("estimated_revenue")
  close_date         DateTime   @map("close_date")
  assigned_to        Int?       @map("assigned_to")
  created_at         DateTime   @default(now()) @map("created_at")
  updated_at         DateTime   @updatedAt @map("updated_at")

  lead               Lead?      @relation(fields: [lead_id], references: [lead_id])
  customer           Customer?  @relation(fields: [customer_id], references: [customer_id])
  followUps          FollowUp[]

  @@map("opportunities")
}

model FollowUp {
  followup_id    Int          @id @default(autoincrement())
  lead_id        Int?         @map("lead_id")
  opportunity_id Int?         @map("opportunity_id")
  scheduled_at   DateTime     @map("scheduled_at")
  completed_at   DateTime?    @map("completed_at")
  status         String       @default("SCHEDULED") @db.VarChar(20) // SCHEDULED, COMPLETED, CANCELLED
  notes          String?      @db.Text
  assigned_to    Int          @map("assigned_to")
  created_at     DateTime     @default(now()) @map("created_at")

  lead           Lead?        @relation(fields: [lead_id], references: [lead_id])
  opportunity    Opportunity? @relation(fields: [opportunity_id], references: [opportunity_id])

  @@map("follow_ups")
}

model QuotationTracking {
  tracking_id  Int       @id @default(autoincrement())
  quote_id     Int       @map("quote_id")
  status       String    @db.VarChar(20) // SENT, VIEWED, ACCEPTED, REJECTED, EXPIRED
  sent_at      DateTime  @default(now()) @map("sent_at")
  responded_at DateTime? @map("responded_at")
  feedback     String?   @db.Text
  created_at   DateTime  @default(now()) @map("created_at")

  quotation    Quotation @relation(fields: [quote_id], references: [quote_id], onDelete: Cascade)

  @@map("quotation_tracking")
}

model AmcContract {
  contract_id       Int                @id @default(autoincrement())
  contract_number   String             @unique @db.VarChar(50) @map("contract_number")
  customer_id       Int                @map("customer_id")
  start_date        DateTime           @map("start_date")
  end_date          DateTime           @map("end_date")
  billing_frequency String             @db.VarChar(20) @map("billing_frequency") // ANNUAL, QUARTERLY
  status            String             @default("ACTIVE") @db.VarChar(20) // ACTIVE, EXPIRED, PENDING_RENEWAL
  annual_value      Decimal            @db.Decimal(12, 2) @map("annual_value")
  created_at        DateTime           @default(now()) @map("created_at")
  updated_at        DateTime           @updatedAt @map("updated_at")

  customer          Customer           @relation(fields: [customer_id], references: [customer_id])
  assets            AmcAsset[]
  schedules         AmcVisitSchedule[]

  @@map("amc_contracts")
}

model AmcAsset {
  asset_id              Int                @id @default(autoincrement())
  contract_id           Int                @map("contract_id")
  part_id               Int                @map("part_id")
  device_name           String             @db.VarChar(100) @map("device_name")
  serial_number         String?            @db.VarChar(50) @map("serial_number")
  last_service_date     DateTime?          @map("last_service_date")
  next_service_date     DateTime?          @map("next_service_date")
  service_interval_days Int                @default(90) @map("service_interval_days")
  created_at            DateTime           @default(now()) @map("created_at")

  contract              AmcContract        @relation(fields: [contract_id], references: [contract_id], onDelete: Cascade)
  part                  Parts              @relation(fields: [part_id], references: [part_id])
  schedules             AmcVisitSchedule[]

  @@map("amc_assets")
}

model AmcVisitSchedule {
  schedule_id    Int         @id @default(autoincrement())
  contract_id    Int         @map("contract_id")
  asset_id       Int?        @map("asset_id")
  planned_date   DateTime    @map("planned_date")
  actual_date    DateTime?   @map("actual_date")
  status         String      @default("PLANNED") @db.VarChar(20) // PLANNED, COMPLETED, MISSED, CANCELLED
  service_job_id Int?        @map("service_job_id")

  contract       AmcContract @relation(fields: [contract_id], references: [contract_id], onDelete: Cascade)
  asset          AmcAsset?   @relation(fields: [asset_id], references: [asset_id])
  serviceJob     ServiceJob? @relation(fields: [service_job_id], references: [job_id])

  @@map("amc_visit_schedules")
}

model TechnicianActivityLog {
  log_id        Int          @id @default(autoincrement())
  visit_id      Int          @map("visit_id")
  technician_id Int          @map("technician_id")
  activity_type String       @db.VarChar(50) @map("activity_type") // CHECK_IN, CHECK_OUT
  latitude      Decimal      @db.Decimal(9, 6)
  longitude     Decimal      @db.Decimal(9, 6)
  timestamp     DateTime     @default(now()) @map("timestamp")

  visit         ServiceVisit @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)
  technician    Technician   @relation(fields: [technician_id], references: [technician_id])

  @@map("technician_activity_logs")
}

model VisitAttachment {
  attachment_id Int          @id @default(autoincrement())
  visit_id      Int          @map("visit_id")
  file_url      String       @db.VarChar(255) @map("file_url")
  file_name     String       @db.VarChar(100) @map("file_name")
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  captured_at   DateTime     @default(now()) @map("captured_at")

  visit         ServiceVisit @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)

  @@map("visit_attachments")
}

model PartsRequest {
  request_id   Int        @id @default(autoincrement())
  job_id       Int        @map("job_id")
  part_id      Int        @map("part_id")
  location_id  Int        @map("location_id")
  quantity     Int
  requested_by Int        @map("requested_by")
  status       String     @default("PENDING") @db.VarChar(20) // PENDING, APPROVED, REJECTED, FULFILLED
  created_at   DateTime   @default(now()) @map("created_at")
  updated_at   DateTime   @updatedAt @map("updated_at")

  job          ServiceJob @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  part         Parts      @relation(fields: [part_id], references: [part_id])
  location     Location   @relation(fields: [location_id], references: [location_id])

  @@map("parts_requests")
}

